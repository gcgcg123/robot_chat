DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PROJECT_HOST=127.0.0.1
PROJECT_PORT=8080
ASR_MODEL_PATH=./models/asr/whisper-large-v3-turbo-ct2
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
DATABASE_PATH=./data/emotional_robot.sqlite3
VOICEPRINT_PROVIDER=ecapa
VOICEPRINT_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
VOICEPRINT_MODEL_DIR=./models/voiceprint/ecapa-voxceleb
VOICEPRINT_DEVICE=cpu
VOICEPRINT_THRESHOLD=0.55
VOICEPRINT_MIN_MARGIN=0.05
# Optional local providers. Leave blank/off for offline-safe rules and lexical retrieval.
IOT_EMOTION_MODEL=
IOT_RISK_MODEL=
IOT_EMBEDDING_MODEL=
IOT_MEMORY_EMBEDDINGS=0
IOT_TTS_PROVIDER=windows
IOT_TTS_VOICE=
# Optional installed Windows SAPI voice names for the two selectable profiles.
IOT_TTS_VOICE_FEMALE=
IOT_TTS_VOICE_MALE=
