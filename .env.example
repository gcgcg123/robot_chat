# ── 這是「範本」，不是實際設定 ──────────────────────────────────────────────
# 第一次執行 `一鍵安裝並啟動.bat` 時，bootstrap-project.ps1 會把本檔複製成 `.env`。
# 之後要調整設定請改 `.env`（未納入 Git），改這個範本對已安裝的機器沒有作用——
# 只有在別台機器／新解壓的副本第一次啟動時才會被採用。
# 改完 `.env` 要重啟服務（`一鍵停止.bat` → `一鍵啟動.bat`）才會生效。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
PROJECT_HOST=127.0.0.1
PROJECT_PORT=8080

# --- ASR backend ---
# sensevoice = SenseVoice-Small (ONNX, no torch, native Cantonese/Mandarin/English)
# whisper    = faster-whisper / CTranslate2, an optional extra: install it with
#              pip install -r requirements-asr-whisper.txt, or leave this on
#              sensevoice and the package is never needed.
# configs/launcher.json sets the same values when you start via the .bat files.
ASR_PROVIDER=sensevoice
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
ASR_SENSEVOICE_MODEL_PATH=./models/asr/sensevoice-small
ASR_CPU_THREADS=8
ASR_USE_ITN=1

# Kept for ASR_PROVIDER=whisper
ASR_MODEL_PATH=./models/asr/whisper-large-v3-turbo-ct2
ASR_BEAM_SIZE=5

# --- Long-term memory ---
# 0 = the user selected in the simulator may read their own memory (default).
# 1 = personal memory additionally requires a verified speaker identity, so an
#     unverified claim only gets shared knowledge. Turn on once voiceprint
#     identification is wired into the turn.
IOT_MEMORY_REQUIRE_IDENTITY=0
# The flywheel itself. Defaults below are the tuned values; see
# docs/MEMORY_FLYWHEEL.md before changing any of them.
#   slot        = basic facts + the most-used ones, always available (cap 32)
#   hot         = recently remembered, consulted when no slot is relevant enough
#   cold        = pseudo-deleted, searched last and revived when asked about again
IOT_MEMORY_SLOT_CAPACITY=32
IOT_MEMORY_PROMOTE_SCORE=1.5
IOT_MEMORY_DEMOTE_SCORE=0.2
IOT_MEMORY_HALF_LIFE_DAYS=14
IOT_MEMORY_HIT_BONUS=0.5
# 0.68 sits between the measured hit band (0.781-1.000) and the miss band
# (0.378-0.579) for question-vs-probe cosine similarity.
IOT_MEMORY_RELEVANCE_FLOOR=0.68
IOT_MEMORY_INJECT_TOP_N=12
IOT_MEMORY_SLOT_TOP_N=4
IOT_MEMORY_AUTO_EXTRACT=1
IOT_MEMORY_MAX_CANDIDATES=3
# Write-path de-duplication: a proposal whose probe is almost the same question
# as an existing row merges into it instead of piling up a near-duplicate.
# 0.9 is measured: "one word apart, different fact" (dog vs cat) reaches 0.826,
# so a lower threshold would merge distinct memories. See docs/MEMORY_FLYWHEEL.md.
IOT_MEMORY_MERGE_SIMILARITY=0.9
# Whether a proposal is the *same fact* as an existing row is decided by the
# similarity of the statements, not by the slot key: "我學會了唱跳rap籃球" and
# "我學會了寫歌詞" share the key `skill` and the probe "我最近學會了什麼？" but are
# two different skills. Measured: same fact 0.8234-0.9738, different fact
# 0.4479-0.7646, so 0.8 separates them. Single-valued keys (name/age/home/...),
# where a correction must replace the old value, bypass this check.
IOT_MEMORY_STATEMENT_MERGE_SIMILARITY=0.8
# Without this model the service still runs, but recall falls back to lexical
# matching and Chinese paraphrases are missed. ~90 MB, downloaded by
# scripts/download-model.ps1 -Model embedding.
IOT_EMBEDDING_MODEL_PATH=./models/embedding/bge-small-zh-v1.5
IOT_EMBEDDING_MAX_LENGTH=128

# Runtime data (database, simulator token, backups) stays inside the checkout.
# Relative paths are resolved against the project root, not the current directory.
DATABASE_PATH=./IoTGroup5/emotional_robot.sqlite3

# --- Local knowledge base (RAG) ---
# Empty database = the feature is simply off: retrieval returns nothing and the prompt is
# unchanged. Import a corpus with scripts/import-knowledge.py (docs/RAG_KNOWLEDGE_PLAN.md).
# The floor is measured, not guessed: on the corpus calibration set the lowest correct-answer
# score is 0.6395 and the highest should-not-answer score is 0.6016, so 0.623 sits between the
# bands. Re-run scripts/calibrate-knowledge.py after adding a document (gate: hit rate >=80%
# and the two bands must not overlap).
IOT_KNOWLEDGE_ENABLED=1
IOT_KNOWLEDGE_FLOOR_SCENARIO=0.623
IOT_KNOWLEDGE_FLOOR_REFERENCE=0.623
IOT_KNOWLEDGE_INJECT_TOP_N=4
# Second-stage reranker. MEASURED (2026-10-03, local bge-reranker-base, A9.7.15): turning it on
# answers 27/28 questions instead of 26/28, but its own score bands overlap the ones it must
# reject (lowest correct -1.67 vs highest should-not-answer +1.53), so a question the manual does
# not answer gets passages as confidently as a real hit, and it costs ~8 s per reranked turn on a
# 4-core CPU. Off by default. local = torch cross-encoder, llm = the chat endpoint (13-45 s).
IOT_KNOWLEDGE_RERANK=0
# Only these four matter when the line above is not 0.
# IOT_KNOWLEDGE_RERANK_BELOW=0.70        # rerank only when the best hybrid score is under this
# IOT_KNOWLEDGE_RERANK_KEEP=3            # how deep into the reranker's ordering to trust
# IOT_KNOWLEDGE_RERANK_FLOOR=-5.0        # stage-2 admission, on the reranker's own score
# IOT_KNOWLEDGE_RERANK_MAX_LENGTH=256    # token window (512 is the model's limit, ~12 s)
# IOT_KNOWLEDGE_RERANK_MODEL=            # override the models/rerank/bge-reranker-base default
# Max-window scoring (schema 8). MEASURED: it lifts the hit band (0.6243 -> 0.6463) and
# widens the safety margin (0.0017 -> 0.0057), but it also promotes unrelated chunks for one
# scenario question, dropping the scanned book from 86% to 79% hit rate. Off by default.
IOT_KNOWLEDGE_WINDOWS=0

# --- Speaker recognition ---
# ecapa = real ECAPA-TDNN speaker embeddings. It needs the optional package set
#         (~730 MB, torch dominates): pip install -r requirements-voiceprint.txt,
#         or run scripts/bootstrap-project.ps1 -WithVoiceprint (also fetches the
#         85 MB model). Until then enrollment answers 503 with that instruction and
#         /health lists voiceprint_dependencies_missing.
# baseline = test/demo placeholder only. It returns [mean, rms, zero-crossing-rate]
#         and cannot tell speakers apart, so do not use it for real enrollment.
VOICEPRINT_PROVIDER=ecapa
VOICEPRINT_MODEL_SOURCE=speechbrain/spkrec-ecapa-voxceleb
VOICEPRINT_MODEL_DIR=./models/voiceprint/ecapa-voxceleb
VOICEPRINT_DEVICE=cpu
VOICEPRINT_THRESHOLD=0.55
VOICEPRINT_MIN_MARGIN=0.05

# --- 本機解譯器（可留空）---
# 啟動器解析順序：IOT_PYTHON（環境變數）→ 本檔的 IOT_PYTHON → configs/launcher.json
#                  → 專案 .venv → PATH 上的 python。
# 若專案跑在 conda/venv 環境（例如 D:\...\envs\robot_chat\python.exe），把路徑填這裡；
# 這是單機設定，.env 未納入 Git，所以不必（也不該）寫進 configs/launcher.json。
IOT_PYTHON=
