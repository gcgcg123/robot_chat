# Docker configuration template. Copy to `.env.docker` (created automatically the
# first time you run `bootstrap-project.ps1 -Docker`) and fill in the password.
#
# Paths are **container** paths, not host paths:
#   data   -> /var/lib/iotgroup5        (named volume `iotgroup5-data`)
#   models -> /models                   (host ./models mounted read-only)
# docker-compose.yml sets IOT_DATA_DIR, DATABASE_PATH and the ASR paths itself,
# so do not override them here unless you also change the volume mounts.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Required: the Dashboard administrator password.
IOT_ADMIN_PASSWORD=change-this-local-password

# --- ASR backend ---
# sensevoice = SenseVoice-Small (ONNX, no torch, native Cantonese/Mandarin/English)
# whisper    = faster-whisper / CTranslate2 (the Whisper runtime is in the image)
ASR_PROVIDER=sensevoice
ASR_SENSEVOICE_MODEL_PATH=/models/asr/sensevoice-small
ASR_MODEL_PATH=/models/asr/whisper-large-v3-turbo-ct2
ASR_DEVICE=cpu
ASR_USE_ITN=1

# --- Local knowledge base (RAG) ---
# The image does NOT contain data/, so the container starts with an empty knowledge base and
# retrieval is simply off (the prompt is unchanged). To use it in Docker: mount the corpus
# and run the importer once against the mounted database --
#   docker compose run --rm -v "%CD%\data:/app/data" dialogue \
#     python scripts/import-knowledge.py --database /var/lib/iotgroup5/emotional_robot.sqlite3
# The floor is measured, not guessed; see .env.example and docs/RAG_KNOWLEDGE_PLAN.md A9.3.
IOT_KNOWLEDGE_ENABLED=1
IOT_KNOWLEDGE_FLOOR_SCENARIO=0.623
IOT_KNOWLEDGE_FLOOR_REFERENCE=0.623
IOT_KNOWLEDGE_INJECT_TOP_N=4
# Second-stage reranker. MEASURED (2026-10-03, local bge-reranker-base, A9.7.15): it answers
# 27/28 questions instead of 26/28, but its own score bands overlap the ones it must reject
# (lowest correct -1.67 vs highest should-not-answer +1.53) and it costs ~8 s per reranked turn
# on a 4-core CPU. Off by default, and the torch weights are not in the image.
IOT_KNOWLEDGE_RERANK=0
# Max-window scoring (schema 8). MEASURED: it lifts the hit band (0.6243 -> 0.6463) and
# widens the safety margin (0.0017 -> 0.0057), but it also promotes unrelated chunks for one
# scenario question, dropping the scanned book from 86% to 79% hit rate. Off by default.
IOT_KNOWLEDGE_WINDOWS=0

# --- Speaker recognition (optional, not in the image by default) ---
# The image installs only requirements.txt + the Whisper runtime. Speaker recognition
# needs ~730 MB more (torch), so it is a build arg instead:
#   $env:WITH_VOICEPRINT=1; docker compose up --build -d
# Without it, enrollment answers 503 with the install command and /health reports
# voiceprint_dependencies_missing. VOICEPRINT_PROVIDER=baseline is a test-only
# placeholder that cannot tell speakers apart, so it is not a substitute.
VOICEPRINT_PROVIDER=ecapa

# --- Long-term memory (see docs/MEMORY_FLYWHEEL.md) ---
# 0 = the user selected in the simulator may read their own memory (default).
# 1 = personal memory additionally requires a verified speaker identity.
IOT_MEMORY_REQUIRE_IDENTITY=0
IOT_MEMORY_SLOT_CAPACITY=32
IOT_MEMORY_PROMOTE_SCORE=1.5
IOT_MEMORY_DEMOTE_SCORE=0.2
IOT_MEMORY_HALF_LIFE_DAYS=14
IOT_MEMORY_HIT_BONUS=0.5
# 0.68 sits between the measured hit band (0.781-1.000) and the miss band
# (0.378-0.579) for question-vs-probe cosine similarity.
IOT_MEMORY_RELEVANCE_FLOOR=0.68
IOT_MEMORY_INJECT_TOP_N=12
IOT_MEMORY_SLOT_TOP_N=4
IOT_MEMORY_AUTO_EXTRACT=1
IOT_MEMORY_MAX_CANDIDATES=3
# Write-path de-duplication: a proposal whose probe is almost the same question
# as an existing row merges into it instead of piling up a near-duplicate.
# 0.9 is measured: "one word apart, different fact" (dog vs cat) reaches 0.826,
# so a lower threshold would merge distinct memories. See docs/MEMORY_FLYWHEEL.md.
IOT_MEMORY_MERGE_SIMILARITY=0.9
# Whether a proposal is the *same fact* as an existing row is decided by the
# similarity of the statements, not by the slot key: "我學會了唱跳rap籃球" and
# "我學會了寫歌詞" share the key `skill` and the probe "我最近學會了什麼？" but are
# two different skills. Measured: same fact 0.8234-0.9738, different fact
# 0.4479-0.7646, so 0.8 separates them. Single-valued keys (name/age/home/...),
# where a correction must replace the old value, bypass this check.
IOT_MEMORY_STATEMENT_MERGE_SIMILARITY=0.8

# Embedding model for memory recall. The container must read it from the mounted
# /models, not from the copy baked into /app/models (which holds only README and
# manifest). Without it the service still runs, but recall degrades to lexical
# matching and Chinese paraphrases are missed.
# Host side: .\scripts\download-model.ps1 -Model embedding
IOT_EMBEDDING_MODEL_PATH=/models/embedding/bge-small-zh-v1.5
IOT_EMBEDDING_MAX_LENGTH=128
